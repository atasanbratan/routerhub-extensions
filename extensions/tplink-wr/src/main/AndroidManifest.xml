<?xml version="1.0" encoding="utf-8"?>
<!--
    A headless extension: no activities, services or receivers, and no permissions. Its code only
    ever runs inside the RouterHub host process, which is also why it needs no INTERNET permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Discovery tag the host scans for (ExtensionContract.FEATURE). required="false" so that no
        store or installer ever rejects the APK for a "missing hardware feature".
    -->
    <uses-feature
        android:name="dev.routerhub.extension"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="RouterHub: TP-Link Wi-Fi routers">

        <!-- Public no-arg class implementing RouterExtension. Leading dot = relative to package. -->
        <meta-data
            android:name="dev.routerhub.extension.class"
            android:value=".TpLinkWrExtension" />

        <!-- router-api version this APK needs (5: settings group ids and translations). -->
        <meta-data
            android:name="dev.routerhub.extension.api"
            android:value="5" />
    </application>
</manifest>
